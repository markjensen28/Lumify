{"type":"before","callId":"call@229","startTime":57128.061,"class":"Frame","method":"evaluateExpression","params":{"expression":"async () => {\n    const canvas = document.querySelector('canvas');\n    if (!canvas) {\n      return false;\n    }\n    const image = new Image();\n    image.src = canvas.toDataURL('image/png');\n    await image.decode();\n    const probe = document.createElement('canvas');\n    probe.width = 64;\n    probe.height = 36;\n    const context = probe.getContext('2d');\n    context.drawImage(image, 0, 0, probe.width, probe.height);\n    const pixels = context.getImageData(0, 0, probe.width, probe.height).data;\n    let variedPixels = 0;\n    for (let i = 0; i < pixels.length; i += 4) {\n      const r = pixels[i];\n      const g = pixels[i + 1];\n      const b = pixels[i + 2];\n      if (r !== g || g !== b || r > 20) {\n        variedPixels += 1;\n      }\n    }\n    return variedPixels > 400;\n  }","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}},"stepId":"pw:api@191","pageId":"page@784532c9afd09de2289b83bbe1e9d9a2","beforeSnapshot":"before@call@229"}
